# chatd configuration. Copy to .env and fill in. Never commit the filled .env.
# At least one platform (Mattermost or Buzz) must be configured.

# --- Core ---
CHATD_BOT_USER_NAME=internkim
CHATD_LISTEN_PORT=18090
# admind base URL. Required for the agent DM surface and for the Buzz mirror
# (chatd resolves identities/channels and stores bridge mappings through admind).
CHATD_ADMIND_BASE_URL=http://127.0.0.1:18080
# Blueclaw agent ingress; required when Mattermost is enabled.
CHATD_BLUECLAW_INGRESS_URL=http://127.0.0.1:8080/connectors/mattermost/events
# Optional; derived from the ingress URL origin when omitted.
CHATD_BLUECLAW_BASE_URL=http://127.0.0.1:8080

# --- Mattermost ---
CHATD_MATTERMOST_BASE_URL=http://127.0.0.1:8065
CHATD_MATTERMOST_BOT_TOKEN=
# Public URL for interactive action callbacks (buttons/selects). Optional.
CHATD_ACTION_CALLBACK_URL=
# Admin token used only to mint per-user access tokens so the mirror posts as
# the real author. Required for Buzz -> Mattermost mirroring; the server also
# needs EnableUserAccessTokens=true.
CHATD_MATTERMOST_ADMIN_TOKEN=

# --- Buzz ---
CHATD_BUZZ_RELAY_URL=ws://127.0.0.1:8080
# The bot's own Buzz secret key, 64 lowercase hex characters.
CHATD_BUZZ_PRIVATE_KEY=
# Optional pubkey->email links file consumed for identity resolution.
CHATD_BUZZ_ACCOUNT_LINKS_PATH=
# Optional extra NIP-42 AUTH tag as a JSON array.
CHATD_BUZZ_AUTH_TAG=

# The bidirectional mirror activates automatically when CHATD_ADMIND_BASE_URL
# and the Buzz variables are set. chatd holds no key seed: admind is the sole
# identity/channel authority and derives everything from its own -buzz-key-seed.
