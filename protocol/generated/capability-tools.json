            "type": "string"
          },
          "requestReason": {
            "description": "Reason for requesting this task. Omit to leave unchanged.",
            "type": "string"
          },
          "size": {
            "description": "Effort size estimate. Omit to leave unchanged.",
            "enum": [
              "XS",
              "S",
              "M",
              "L",
              "XL",
              "XXL"
            ],
            "type": "string"
          },
          "startDate": {
            "description": "Date in YYYY-MM-DD format. Omit to leave unchanged.",
            "type": "string"
          },
          "status": {
            "description": "New task status. Omit to leave unchanged.",
            "enum": [
              "예정",
              "진행",
              "완료",
              "요청",
              "일시정지",
              "기각",
              "중단"
            ],
            "type": "string"
          },
          "taskID": {
            "description": "Exact ID of the task to update, copied from a task.list result.",
            "type": "string"
          },
          "title": {
            "description": "New task title. Omit to leave the title unchanged.",
            "type": "string"
          },
          "type": {
            "description": "Task type classification, e.g. 'task', 'milestone'. Omit to leave unchanged.",
            "type": "string"
          }
        },
        "required": [
