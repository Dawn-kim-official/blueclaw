      "completionEvidence": {
        "action": "write_task",
        "mode": "success",
        "targetKind": "task"
      },
      "description": "Create a new workspace task with typed task fields. Use this to add a todo or assignment for the requester or another team member. Do not use this to update an existing task — use task.update.",
      "estimatedLatency": "medium",
      "idempotency": {
        "required": false,
        "scope": "operation",
        "supported": false
      },
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "endDate": {
            "description": "Due date in yyyy-mm-dd format. Resolve relative dates from the current date. Omit when the user did not specify one.",
            "type": "string"
          },
          "goal": {
            "description": "Definition of done or desired outcome. Omit when the title already states the complete outcome.",
            "type": "string"
          },
          "participantPersonHints": {
            "description": "Names, @handles, or emails of additional participants explicitly named by the user. The owner is included automatically.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "size": {
            "description": "Effort size using the work-size rubric. Omit when the request does not support a useful estimate.",
            "enum": [
              "XS",
              "S",
              "M",
              "L",
              "XL",
              "XXL"
            ],
            "type": "string"
          },
          "startDate": {
            "description": "Date in YYYY-MM-DD format. Resolve relative dates from the current date. Omit when the user did not specify one.",
            "type": "string"
          },
          "status": {
            "description": "Initial task status. Defaults to 예정. The runtime may change delegated tasks to 요청.",
            "enum": [
              "예정",
              "진행",
              "완료",
              "일시정지",
              "기각",
              "중단"
            ],
            "type": "string"
          },
          "targetPersonHint": {
            "description": "Name or email of the person the task belongs to, e.g. 'Alice' or 'alice@example.com'. Leave empty to assign to the requester themselves.",
            "type": "string"
          },
          "title": {
            "description": "Concise task title. Preserve the user's exact title when they provide one; otherwise derive it directly from their request.",
            "type": "string"
          }
        },
        "required": [
          "title"
        ],
        "type": "object"
      },
