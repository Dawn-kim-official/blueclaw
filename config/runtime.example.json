{
  "baseURL": "http://127.0.0.1:8080",
  "capabilities": {
    "endpoint": "http://127.0.0.1:7781",
    "unixSocketPath": "/run/internkim/capability.sock",
    "timeoutSecond": 15,
    "toolNames": [
      "browser.open",
      "user.confirm",
      "file.pick"
    ],
    "toolDescriptors": [
      {
        "name": "browser.open",
        "version": "1",
        "privacyClass": "user_browser",
        "estimatedLatency": "interactive",
        "requiresUserPresence": true,
        "worksOffline": false,
        "inputSchema": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string"
            },
            "startURL": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "sideEffectClass": "browser"
      },
      {
        "name": "user.confirm",
        "version": "1",
        "privacyClass": "user_input",
        "estimatedLatency": "interactive",
        "requiresUserPresence": true,
        "worksOffline": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "message": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "message"
          ],
          "additionalProperties": false
        },
        "sideEffectClass": "approval",
        "requiresApproval": true
      },
      {
        "name": "file.pick",
        "version": "1",
        "privacyClass": "local_file",
        "estimatedLatency": "interactive",
        "requiresUserPresence": true,
        "worksOffline": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "message": {
              "type": "string"
            },
            "accept": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "multiple": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "sideEffectClass": "local_file",
        "requiresApproval": true
      }
    ]
  },
  "languageModel": {
    "defaultProvider": "capabilityLLM",
    "capability": {
      "executionMode": "auto"
    },
    "sdkd": {
      "unixSocketPath": "/run/blueclaw-sdkd/sdkd.sock",
      "authKeyPath": "/run/credentials/sdkd-auth-key",
      "executionMode": "auto",
      "timeoutSecond": 60,
      "shadowEnabled": false,
      "structuredSchemaNames": ["blueclaw_agent_turn_action"]
    }
  },
  "firecracker": {
    "firecrackerPath": "/usr/local/bin/firecracker",
    "jailerPath": "/usr/local/bin/jailer",
    "kernelImagePath": "/opt/internkim/blueclaw-runtime/vmlinux.bin",
    "rootfsImagePath": "/opt/internkim/blueclaw-runtime/rootfs.ext4",
    "workspaceImagePath": "/var/lib/blueclaw/workspace.ext4",
    "vcpuCount": 4,
    "memoryMiB": 8192,
    "vsockCID": 52,
    "healthPortOrService": "8082",
    "guestHTTPPortOrService": "8081",
    "hostHTTPListenAddress": "127.0.0.1:8080",
    "logDirectoryPath": "/var/log/blueclaw-supervisor",
    "runtimeDirectoryPath": "/var/lib/bc",
    "outboundNetwork": {
      "enabled": true,
      "hostDeviceName": "bctap0",
      "guestMACAddress": "AA:FC:00:00:00:01",
      "networkCIDR": "172.31.0.0/30",
      "hostAddressCIDR": "172.31.0.1/30",
      "guestAddressCIDR": "172.31.0.2/30",
      "guestGateway": "172.31.0.1"
    }
  },
  "bridge": {
    "mode": "localAgent",
    "authMode": "sshKeyReuse",
    "authorizedPublicKeysPath": "/var/lib/blueclaw/authorized_companions",
    "listenAddress": "127.0.0.1:7778"
  },
  "database": {
    "driver": "postgres",
    "connectionString": "postgres://blueclaw@/blueclaw?host=/var/run/postgresql&sslmode=disable",
    "migrationDirectoryPath": "/workspace/.blueclaw/migrations"
  },
  "memory": {
    "workspaceID": "default",
    "graphitiEndpoint": "http://127.0.0.1:7791",
    "graphitiKuzuPath": "/workspace/.blueclaw/graphiti/kuzu",
    "timeoutSecond": 15
  },
  "agent": {
    "intake": {
      "enabled": true,
      "executionMode": "auto"
    },
    "defaultEffortLevel": "standard",
    "toolResultMaxBytes": 32768,
    "failureRecovery": {
      "failureDebtFinalizationGate": true,
      "attemptFingerprint": "tool_input_error_code",
      "recoveryBudget": {
        "correctedRetry": 1,
        "alternateRoute": 1,
        "adjacentTool": 2,
        "noToolFallback": 1
      }
    }
  },
  "connectors": {
    "mattermost": {},
    "slack": {},
    "signal": {
      "enabled": false
    }
  },
  "logging": {
    "directoryPath": "/workspace/.blueclaw/logs",
    "retentionDays": 7
  },
  "agentProfiles": [
    {
      "name": "planner",
      "allowedToolNames": [
        "mcp.workspace.list"
      ]
    },
    {
      "name": "researcher",
      "allowedToolNames": [
        "mcp.workspace.read"
      ]
    }
  ],
  "mcpServers": [
    {
      "name": "workspace",
      "transport": "stdio",
      "command": "blueclaw-mcp-workspace"
    }
  ],
  "terminal": {
    "mode": "firecrackerGuest",
    "workspaceRootPath": "/workspace",
    "allowedExecutableNames": [
      "bash",
      "sh",
      "git",
      "glab",
      "rg",
      "find",
      "ls",
      "cat",
      "sed",
      "awk",
      "grep",
      "mkdir",
      "touch",
      "cp",
      "mv",
      "rm",
      "tar",
      "gzip",
      "bun",
      "go",
      "capability"
    ],
    "deniedExecutableNames": [
      "sudo",
      "su",
      "doas",
      "pkexec",
      "mount",
      "umount",
      "systemctl",
      "service",
      "apt",
      "apt-get",
      "dpkg",
      "yum",
      "dnf",
      "apk",
      "pacman",
      "snap",
      "flatpak",
      "rpm",
      "modprobe",
      "insmod",
      "shutdown",
      "reboot",
      "halt",
      "poweroff",
      "useradd",
      "userdel",
      "usermod",
      "groupadd",
      "groupdel",
      "passwd",
      "chpasswd",
      "visudo",
      "iptables",
      "nft",
      "sysctl"
    ],
    "timeoutSecond": 120,
    "outputMaxBytes": 32768,
    "sessionMaxCount": 4,
    "allowNetwork": true,
    "allowInteractiveShell": true
  },
  "scheduler": {
    "retentionCheckIntervalMinute": 60,
    "taskSchedulePollIntervalSecond": 30
  }
}
